<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0004-1" author="admin">
        <createTable tableName="books_rating">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_books_rating_user_id"
                             referencedTableName="users"
                             referencedColumnNames="id"
                />
            </column>
            <column name="book_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_books_rating_book_id"
                             referencedTableName="book"
                             referencedColumnNames="id"
                />
            </column>
            <column name="rating" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint constraintName="unique_books_rating"
                             tableName="books_rating"
                             columnNames="user_id, book_id"
        />
    </changeSet>
</databaseChangeLog>